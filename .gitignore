dist/
build/

# Editor backups
.editor_tools_backups/
\"


# Browser data (contains cookies, sessions, cache) — all under system/
# The active-account symlink is local runtime state — never commit it.
# (The trailing-slash rule below only matches directories, NOT the symlink,
#  which is exactly why the symlink leaked into git before.)
system/browser-data
system/browser-data*/
system/browser-scraper-data/
system/automation-browser-data/
system/automation-browser-data.bak/
system/browser-scraper-data.bak/
scraper_output/


# Uploads (user-uploaded files)
uploads/
system/uploads

# Secrets & credentials
.env
.env.*
!.env.example
*.key
*.pem
system/.session_tokens.json
system/.auth_token
.sable_backups

# OS junk
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
output/

# Logs
*.log



