# ═══════════════════════════════════════════
# Common — shared between Sable & Sable-lite
# ═══════════════════════════════════════════

# Backup files
*.bak

# Database
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
connectors/opencode/bin/
.venv/
*.egg-info/
dist/
build/
# Vendored pdf.js ships PREBUILT .mjs — the broad `build/` rule above swallows
# it, so a fresh clone gets no pdf.min.mjs and the Study reader dies on import.
# Re-include the directory itself, then its contents (git won't descend into an
# ignored dir to re-include files).
!web/vendor/pdfjs/build/
!web/vendor/pdfjs/build/**

# Editor backups
.editor_tools_backups/

# Secrets & credentials
.env
.env.*
!.env.example
*.key
*.pem
.sable_backups
.safe_backups/skills/_cache/

# OS junk
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Output & test
output/
test/
mockups/
scraper_output/

# Uploads
uploads/

# System caches & model artifacts (NOT browser data or tokens)
system/cache/
system/memory_cache*.npz
system/cookbook_logs/
system/cookbook_model_settings.json
system/uploads/
system/models/
system/fastembed_cache/
system/.sync_failed_accounts


