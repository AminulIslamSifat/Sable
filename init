#!/bin/bash

# Exit immediately if a command exits with a non-zero status
set -e

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
UV_BIN="$(command -v uv || true)"
cd "$PROJECT_ROOT"

# Color definitions
CYAN='\033[1;36m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
NC='\033[0m' # No Color

echo -e "${CYAN}==========================================${NC}"
echo -e "${CYAN}      Project Setup & Initialization      ${NC}"
echo -e "${CYAN}==========================================${NC}"

# 1. Run uv sync
echo -e "\n${YELLOW}[+] Synchronizing dependencies with uv...${NC}"
uv sync
echo -e "${GREEN}[✓] Success: Dependencies synchronized${NC}"

# 2. Install Playwright Chromium
echo -e "\n${YELLOW}[+] Installing Playwright Chromium browser...${NC}"
uv run playwright install chromium
echo -e "${GREEN}[✓] Success: Playwright Chromium installed${NC}"

# 3. Run browser opener engine
echo -e "\n${YELLOW}[+] Running the browser opener engine... Log in into Qwen and DeepSeek in the browser.${NC}"
# Explicit profile 1: create browser-data-acc1 directly, never rely on the
# (possibly dangling on a fresh clone) system/browser-data symlink.
uv run python -m engine.browser_opener 1
echo -e "${GREEN}[✓] Success: Browser opener executed${NC}"

# 3.5. Set up account profile structure and distribute to all slots (under system/)
echo -e "\n${YELLOW}[+] Setting up account profiles and distributing...${NC}"
mkdir -p system

# Migrate browser-data → browser-data-acc1 + symlink (first-run only)
if [ -d "system/browser-data" ] && [ ! -L "system/browser-data" ]; then
    if [ ! -d "system/browser-data-acc1" ]; then
        echo -e "${YELLOW}[i] Migrating browser-data → browser-data-acc1...${NC}"
        mv system/browser-data system/browser-data-acc1
    else
        echo -e "${CYAN}[i] browser-data-acc1 already exists, removing raw browser-data${NC}"
        rm -rf system/browser-data
    fi
fi

# Ensure symlink exists: create if missing, REPAIR if dangling (the fresh-clone
# break case), but never clobber a valid link (preserves the active account on re-runs).
if [ -L "system/browser-data" ] && [ ! -e "system/browser-data" ]; then
    echo -e "${YELLOW}[i] Repairing dangling symlink system/browser-data → browser-data-acc1${NC}"
    ln -sfn browser-data-acc1 system/browser-data
elif [ ! -e "system/browser-data" ] && [ ! -L "system/browser-data" ]; then
    ln -s browser-data-acc1 system/browser-data
    echo -e "${GREEN}[✓] Symlink: system/browser-data → browser-data-acc1${NC}"
else
    echo -e "${CYAN}[i] system/browser-data already points to a valid target, leaving as-is${NC}"
fi

# Distribute from acc1 to other profile slots
SRC="system/browser-data-acc1"
for target in system/browser-data.bak system/browser-scraper-data system/automation-browser-data system/automation-browser-data.bak; do
    if [ ! -d "$target" ]; then
        echo -e "${YELLOW}[i] Creating $target from $SRC...${NC}"
        cp -r "$SRC" "$target"
    else
        echo -e "${CYAN}[i] $target already exists, skipping${NC}"
    fi
done

echo -e "${GREEN}[✓] Success: Browser profiles distributed${NC}"


# 4. Ask for a password and save it to system/.auth_token
echo -e "\n${YELLOW}[+] Setting up authentication token...${NC}"
mkdir -p system

read -s -p "Please enter the password to save: " password
echo
echo "$password" > system/.auth_token
echo -e "${GREEN}[✓] Password successfully saved to system/.auth_token${NC}"

# 5. Copy example instruction file if it doesn't exist
if [ -f "instruction/Maria.md.example" ]; then
    if [ ! -f "instruction/Maria.md" ]; then
        echo -e "\n${YELLOW}[+] Creating Maria.md from template...${NC}"
        mv instruction/Maria.md.example instruction/Maria.md
        echo -e "${GREEN}[✓] Success: Maria.md created${NC}"
    else
        echo -e "\n${CYAN}[i] instruction/Maria.md already exists, skipping copy to prevent overwriting.${NC}"
    fi
else
    echo -e "\n${RED}[!] Warning: instruction/Maria.md.example not found, skipping step.${NC}"
fi

# 6. Copy example memory file if it doesn't exist
if [ -f "Brain/Memory.json.example" ]; then
    if [ ! -f "Brain/Memory.json" ]; then
        echo -e "\n${YELLOW}[+] Creating Memory.json from template...${NC}"
        mv Brain/Memory.json.example Brain/Memory.json
        echo -e "${GREEN}[✓] Success: Memory.json created${NC}"
    else
        echo -e "\n${CYAN}[i] Brain/Memory.json already exists, skipping copy to prevent overwriting.${NC}"
    fi
else
    echo -e "\n${RED}[!] Warning: Brain/Memory.json.example not found, skipping step.${NC}"
fi

# 7. Make start executable
if [ -f "start" ]; then
    echo -e "\n${YELLOW}[+] Making 'start', 'status', 'stop' executable...${NC}"
    chmod +x start
    chmod +x status
    chmod +x stop
    echo -e "${GREEN}[✓] Success: 'start', 'status', 'stop' is now executable${NC}"
else
    echo -e "\n${RED}[!] Warning: 'start' script not found in the root directory.${NC}"
fi

# 8. Install systemd user service
echo -e "\n${YELLOW}[+] Installing systemd user service...${NC}"
mkdir -p "${HOME}/.config/systemd/user"

if [ -z "$UV_BIN" ]; then
    echo -e "${RED}[!] Warning: uv not found in PATH; the systemd unit may fail to start.${NC}"
fi

cat > "${HOME}/.config/systemd/user/sable.service" <<EOF
[Unit]
Description=Sable chat server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=${PROJECT_ROOT}
ExecStart=${UV_BIN:-/usr/bin/env uv} run python server.py
Restart=on-failure
RestartSec=3
Environment=TERM=xterm-256color

[Install]
WantedBy=default.target
EOF

systemctl --user daemon-reload || true
systemctl --user enable sable.service >/dev/null 2>&1 || true

echo -e "${GREEN}[✓] Success: systemd user service installed and enabled (sable.service)${NC}"

echo -e "\n${CYAN}==========================================${NC}"
echo -e "${GREEN}         Setup Completed Successfully!    ${NC}"
echo -e "${CYAN}==========================================${NC}"
echo -e "You can now start the service using:"
echo -e "  ${GREEN}./start${NC}"
echo -e "or:"
echo -e "  ${GREEN}systemctl --user start sable${NC}"
echo -e "${CYAN}------------------------------------------${NC}"