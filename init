#!/bin/bash

# Exit immediately if a command exits with a non-zero status
set -e

# Color definitions
CYAN='\033[1;36m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
NC='\033[0m' # No Color

echo -e "${CYAN}==========================================${NC}"
echo -e "${CYAN}      Project Setup & Initialization      ${NC}"
echo -e "${CYAN}==========================================${NC}"

# 1. Run uv sync
echo -e "\n${YELLOW}[+] Synchronizing dependencies with uv...${NC}"
uv sync
echo -e "${GREEN}[✓] Success: Dependencies synchronized${NC}"

# 2. Install Playwright Chromium
echo -e "\n${YELLOW}[+] Installing Playwright Chromium browser...${NC}"
uv run playwright install chromium
echo -e "${GREEN}[✓] Success: Playwright Chromium installed${NC}"

# 3. Run browser opener engine
echo -e "\n${YELLOW}[+] Running the browser opener engine...${NC}"
uv run python engine/browser_opener.py
echo -e "${GREEN}[✓] Success: Browser opener executed${NC}"

# 3.5. Distribute browser-data to all profile slots (under system/)
echo -e "\n${YELLOW}[+] Distributing browser profile to all slots...${NC}"
mkdir -p system

SRC="system/browser-data"
for target in system/browser-scraper-data system/automation-browser-data system/automation-browser-data.bak; do
    if [ ! -d "$target" ]; then
        echo -e "${YELLOW}[i] Creating $target from $SRC...${NC}"
        cp -r "$SRC" "$target"
    else
        echo -e "${CYAN}[i] $target already exists, skipping${NC}"
    fi
done

echo -e "${GREEN}[✓] Success: Browser profiles distributed${NC}"


# 4. Ask for a password and save it to system/.auth_token
echo -e "\n${YELLOW}[+] Setting up authentication token...${NC}"
mkdir -p system

read -s -p "Please enter the password to save: " password
echo
echo "$password" > system/.auth_token
echo -e "${GREEN}[✓] Password successfully saved to system/.auth_token${NC}"

# 5. Copy example instruction file if it doesn't exist
if [ -f "instruction/Maria.md.example" ]; then
    if [ ! -f "instruction/Maria.md" ]; then
        echo -e "\n${YELLOW}[+] Creating Maria.md from template...${NC}"
        cp instruction/Maria.md.example instruction/Maria.md
        echo -e "${GREEN}[✓] Success: Maria.md created${NC}"
    else
        echo -e "\n${CYAN}[i] instruction/Maria.md already exists, skipping copy to prevent overwriting.${NC}"
    fi
else
    echo -e "\n${RED}[!] Warning: instruction/Maria.md.example not found, skipping step.${NC}"
fi

# 6. Copy example memory file if it doesn't exist
if [ -f "Brain/Memory.json.example" ]; then
    if [ ! -f "Brain/Memory.json" ]; then
        echo -e "\n${YELLOW}[+] Creating Memory.json from template...${NC}"
        cp Brain/Memory.json.example Brain/Memory.json
        echo -e "${GREEN}[✓] Success: Memory.json created${NC}"
    else
        echo -e "\n${CYAN}[i] Brain/Memory.json already exists, skipping copy to prevent overwriting.${NC}"
    fi
else
    echo -e "\n${RED}[!] Warning: Brain/Memory.json.example not found, skipping step.${NC}"
fi

# 7. Make start executable
if [ -f "start" ]; then
    echo -e "\n${YELLOW}[+] Making 'start' executable...${NC}"
    chmod +x start
    echo -e "${GREEN}[✓] Success: 'start' is now executable${NC}"
else
    echo -e "\n${RED}[!] Warning: 'start' script not found in the root directory.${NC}"
fi

echo -e "\n${CYAN}==========================================${NC}"
echo -e "${GREEN}         Setup Completed Successfully!    ${NC}"
echo -e "${CYAN}==========================================${NC}"
echo -e "You can now run the application using:"
echo -e "  ${GREEN}./start${NC}"
echo -e "${CYAN}------------------------------------------${NC}"