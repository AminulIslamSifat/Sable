#!/bin/bash
set -e

SERVICE="sable.service"
SABLE_PORT="${SABLE_PORT:-61770}"
SABLE_URL="http://127.0.0.1:${SABLE_PORT}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
UV_BIN="$(command -v uv || true)"

cd "$SCRIPT_DIR"

# ── First-run bootstrap (skipped if already done) ──────────────────────

# Playwright chromium (idempotent — skips if already installed)
uv run playwright install chromium 2>/dev/null || true

# Template files
if [ -f "instruction/Maria.md.example" ] && [ ! -f "instruction/Maria.md" ]; then
    cp instruction/Maria.md.example instruction/Maria.md
    echo "📝 Created instruction/Maria.md from template"
fi
if [ -f "Brain/Memory.json.example" ] && [ ! -f "Brain/Memory.json" ]; then
    cp Brain/Memory.json.example Brain/Memory.json
    echo "🧠 Created Brain/Memory.json from template"
fi

# Browser profile symlink
mkdir -p system
if [ -d "system/browser-data" ] && [ ! -L "system/browser-data" ]; then
    # Migrate legacy non-symlink dir
    if [ ! -d "system/browser-data-acc1" ]; then
        mv system/browser-data system/browser-data-acc1
    else
        rm -rf system/browser-data
    fi
fi
if [ ! -e "system/browser-data" ]; then
    ln -s browser-data-acc1 system/browser-data 2>/dev/null || true
fi

# Systemd user service (one-time install)
if ! systemctl --user cat "$SERVICE" >/dev/null 2>&1; then
    mkdir -p "${HOME}/.config/systemd/user"
    cat > "${HOME}/.config/systemd/user/${SERVICE}" <<EOF
[Unit]
Description=Sable chat server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=${SCRIPT_DIR}
ExecStart=${UV_BIN:-/usr/bin/env uv} run python server.py
Restart=on-failure
RestartSec=3
Environment=TERM=xterm-256color

[Install]
WantedBy=default.target
EOF
    systemctl --user daemon-reload 2>/dev/null || true
    systemctl --user enable "$SERVICE" >/dev/null 2>&1 || true
    echo "⚙️  Installed systemd user service: $SERVICE"
fi

# ── Start ───────────────────────────────────────────────────────────────

echo "🔄 Synchronizing dependencies..."
uv sync
echo ""

print_info_box() {
    local url="$1" port="$2" service="$3"
    
    # 54 horizontal box-drawing dashes
    local line="──────────────────────────────────────────────────────"
    
    echo ""
    echo "╭${line}╮"
    echo "│ 🚀 Sable is running!                                 │"
    echo "│                                                      │"
    printf "│ 🌐 URL:    %-41s │\n" "${url}"
    printf "│ 📡 Port:   %-41s │\n" "${port}"
    echo "│                                                      │"
    printf "│ 📋 Status: systemctl --user status %-15s   │\n" "${service}"
    printf "│ 📜 Logs:   journalctl --user -u %-15s -f   │\n" "${service}"
    echo "╰${line}╯"
    echo ""
}

# Auto-open browser after server starts
open_browser() {
    sleep 5
    if command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$SABLE_URL" 2>/dev/null &
    elif command -v open >/dev/null 2>&1; then
        open "$SABLE_URL" 2>/dev/null &
    fi
}

if systemctl --user cat "$SERVICE" >/dev/null 2>&1; then
    echo "Starting Sable via systemd..."
    systemctl --user start "$SERVICE"
    sleep 1
    if systemctl --user is-active --quiet "$SERVICE"; then
        print_info_box "$SABLE_URL" "$SABLE_PORT" "$SERVICE"
        open_browser
    else
        echo "⚠️  Service failed to start. Clearing stale browser profile and retrying..."
        rm -rf "$SCRIPT_DIR/system/browser-data"
        systemctl --user restart "$SERVICE"
        sleep 1
        if systemctl --user is-active --quiet "$SERVICE"; then
            print_info_box "$SABLE_URL" "$SABLE_PORT" "$SERVICE"
            open_browser
        else
            echo "❌ Still failing after profile reset. Check logs:"
            echo "   journalctl --user -u $SERVICE -n 30 --no-pager"
            exit 1
        fi
    fi
else
    echo "systemd user service not found — starting the server directly with uv..."
    print_info_box "$SABLE_URL" "$SABLE_PORT" "(direct)"
    open_browser &
    exec uv run python server.py
fi
