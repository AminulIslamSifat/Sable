#!/bin/bash
set -e

SERVICE="sable.service"
SABLE_PORT="${SABLE_PORT:-61770}"
SABLE_URL="http://127.0.0.1:${SABLE_PORT}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
UV_BIN="$(command -v uv || true)"

_log() { echo "[START $(date +%H:%M:%S)] $*"; }

_log "▶ Sable start script initialized"
_log "  SCRIPT_DIR=$SCRIPT_DIR"
_log "  UV_BIN=${UV_BIN:-'(not found)'}"
_log "  SABLE_PORT=$SABLE_PORT"

# Parse --background flag (skip browser, info box; used by update restart)
BACKGROUND=0
for arg in "$@"; do
    case "$arg" in
        --background) BACKGROUND=1 ;;
    esac
done
_log "  BACKGROUND=$BACKGROUND"

cd "$SCRIPT_DIR"
_log "✓ cd to $SCRIPT_DIR"

# ── First-run bootstrap (skipped if already done) ──────────────────────

# Playwright chromium (idempotent — skips if already installed)
_log "↳ Checking Playwright browsers..."
uv run playwright install chromium || true
_log "✓ Playwright check done"

# Template files
_log "↳ Checking template files..."
if [ -f "instruction/Maria.md.example" ] && [ ! -f "instruction/Maria.md" ]; then
    cp instruction/Maria.md.example instruction/Maria.md
    _log "  ✓ Created instruction/Maria.md from template"
else
    _log "  · Maria.md already exists or no template"
fi
if [ -f "Brain/Memory.json.example" ] && [ ! -f "Brain/Memory.json" ]; then
    cp Brain/Memory.json.example Brain/Memory.json
    _log "  ✓ Created Brain/Memory.json from template"
else
    _log "  · Memory.json already exists or no template"
fi

# Browser profile symlink
_log "↳ Checking browser profile symlink..."
mkdir -p system
if [ -d "system/browser-data" ] && [ ! -L "system/browser-data" ]; then
    _log "  · Migrating legacy non-symlink browser-data dir..."
    if [ ! -d "system/browser-data-acc1" ]; then
        mv system/browser-data system/browser-data-acc1
        _log "  ✓ Moved to browser-data-acc1"
    else
        rm -rf system/browser-data
        _log "  ✓ Removed stale browser-data (acc1 exists)"
    fi
fi
if [ ! -e "system/browser-data" ]; then
    ln -s browser-data-acc1 system/browser-data 2>/dev/null || true
    _log "  ✓ Created symlink browser-data → browser-data-acc1"
else
    _log "  · browser-data symlink/dir already exists"
fi

# ── Ensure Docker is installed and running ─────────────────────────────
ensure_docker() {
    # Already working?
    if docker info >/dev/null 2>&1; then
        _log "  · Docker installed and daemon running"
        return 0
    fi

    # CLI exists but daemon not running — try to start it
    if command -v docker >/dev/null 2>&1; then
        _log "  · Docker CLI found but daemon not running"
        _log "  ↳ Attempting to start Docker daemon via systemd..."
        if sudo systemctl start docker 2>/dev/null && sudo systemctl enable docker 2>/dev/null; then
            # Wait for socket
            for i in 1 2 3 4 5; do
                if docker info >/dev/null 2>&1; then
                    _log "✓ Docker daemon started and enabled"
                    return 0
                fi
                sleep 1
            done
            _log "✗ Docker daemon failed to start after systemctl start"
            return 1
        else
            _log "✗ Could not start Docker daemon (systemctl failed)"
            return 1
        fi
    fi

    # Docker not installed at all — detect distro and install
    _log "  · Docker not installed, attempting auto-install..."
    local install_cmd=""
    if command -v apt-get >/dev/null 2>&1; then
        install_cmd="apt-get update && apt-get install -y docker.io docker-compose-plugin"
    elif command -v dnf >/dev/null 2>&1; then
        install_cmd="dnf install -y docker docker-compose-plugin"
    elif command -v pacman >/dev/null 2>&1; then
        install_cmd="pacman -Sy --noconfirm docker docker-compose"
    elif command -v zypper >/dev/null 2>&1; then
        install_cmd="zypper install -y docker docker-compose"
    else
        _log "✗ Unsupported package manager — please install Docker manually"
        return 1
    fi

    _log "  ↳ Running: sudo sh -c '$install_cmd'"
    if ! sudo sh -c "$install_cmd"; then
        _log "✗ Docker installation failed"
        return 1
    fi

    # Enable and start
    sudo systemctl enable docker 2>/dev/null || true
    sudo systemctl start docker 2>/dev/null || true
    for i in 1 2 3 4 5; do
        if docker info >/dev/null 2>&1; then
            _log "✓ Docker installed, started, and enabled"
            return 0
        fi
        sleep 1
    done
    _log "✗ Docker installed but daemon failed to start"
    return 1
}

# SearXNG search backend (Docker, idempotent)
_log "↳ Checking SearXNG search backend..."
if ensure_docker; then
    if ! docker ps --format '{{.Names}}' 2>/dev/null | grep -q '^searxng$'; then
        _log "  · SearXNG not running, starting..."
        # Remove stopped container if it exists
        docker rm -f searxng >/dev/null 2>&1 || true
        if ! docker image inspect searxng/searxng:latest >/dev/null 2>&1; then
            echo "   Pulling searxng/searxng:latest (first time only)..."
            docker pull searxng/searxng:latest
        fi
        docker run -d --name searxng \
            -p 8080:8080 \
            -e SEARXNG_BASE_URL=http://localhost:8080/ \
            --restart unless-stopped \
            searxng/searxng:latest >/dev/null 2>&1
        # Enable JSON API format
        sleep 2
        docker exec searxng sh -c 'grep -q "formats:" /etc/searxng/settings.yml || cat >> /etc/searxng/settings.yml << SEOF

search:
  formats:
    - html
    - json
SEOF
' 2>/dev/null
        docker restart searxng >/dev/null 2>&1
        _log "✓ SearXNG ready on http://localhost:8080"
    else
        _log "✓ SearXNG already running"
    fi
else
    _log "⚠ Docker unavailable (install/start failed) — SearXNG search backend skipped"
fi

# Systemd user service (one-time install)
_log "↳ Checking systemd user service..."
if ! systemctl --user cat "$SERVICE" >/dev/null 2>&1; then
    _log "  · Service not installed, creating..."
    mkdir -p "${HOME}/.config/systemd/user"
    cat > "${HOME}/.config/systemd/user/${SERVICE}" <<EOF
[Unit]
Description=Sable chat server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=${SCRIPT_DIR}
ExecStart=${UV_BIN:-/usr/bin/env uv} run python server.py
Restart=on-failure
RestartSec=3
Environment=TERM=xterm-256color

[Install]
WantedBy=default.target
EOF
    systemctl --user daemon-reload 2>/dev/null || true
    systemctl --user enable "$SERVICE" >/dev/null 2>&1 || true
    _log "✓ Installed systemd user service: $SERVICE"
else
    _log "  · Service already installed"
fi

# ── Start ───────────────────────────────────────────────────────────────
_log "▶ Starting Sable..."
_log "↳ Synchronizing dependencies (uv sync)..."
uv sync
_log "✓ Dependencies synced"

print_info_box() {
    local url="$1" port="$2" service="$3"
    
    # 54 horizontal box-drawing dashes
    local line="──────────────────────────────────────────────────────"
    
    echo ""
    echo "╭${line}╮"
    echo "│ 🚀 Sable is running!                                 │"
    echo "│                                                      │"
    printf "│ 🌐 URL:    %-41s │\n" "${url}"
    printf "│ 📡 Port:   %-41s │\n" "${port}"
    echo "│                                                      │"
    printf "│ 📋 Status: systemctl --user status %-15s   │\n" "${service}"
    printf "│ 📜 Logs:   journalctl --user -u %-15s -f   │\n" "${service}"
    echo "╰${line}╯"
    echo ""
}

# Auto-open browser after server starts
open_browser() {
    sleep 5
    if command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$SABLE_URL" 2>/dev/null &
    elif command -v open >/dev/null 2>&1; then
        open "$SABLE_URL" 2>/dev/null &
    elif command -v python3 >/dev/null 2>&1; then
        python3 -c "import webbrowser; webbrowser.open('$SABLE_URL')" 2>/dev/null &
    fi
}

if systemctl --user cat "$SERVICE" >/dev/null 2>&1; then
    _log "↳ Starting via systemd ($SERVICE)..."
    systemctl --user start "$SERVICE"
    _log "  · Waiting for service to become active..."
    sleep 1
    if systemctl --user is-active --quiet "$SERVICE"; then
        _log "✓ Service is active!"
        if [ "$BACKGROUND" -eq 0 ]; then
            print_info_box "$SABLE_URL" "$SABLE_PORT" "$SERVICE"
            open_browser
        fi
    else
        _log "⚠ Service failed to start! Clearing stale browser profile and retrying..."
        rm -rf "$SCRIPT_DIR/system/browser-data"
        _log "  ↳ Restarting service after profile reset..."
        systemctl --user restart "$SERVICE"
        sleep 1
        if systemctl --user is-active --quiet "$SERVICE"; then
            _log "✓ Service active after profile reset!"
            if [ "$BACKGROUND" -eq 0 ]; then
                print_info_box "$SABLE_URL" "$SABLE_PORT" "$SERVICE"
                open_browser
            fi
        else
            _log "✗ STILL FAILING after profile reset!"
            _log "  Check logs: journalctl --user -u $SERVICE -n 30 --no-pager"
            exit 1
        fi
    fi
else
    _log "⚠ systemd user service not found — starting directly with uv..."
    if [ "$BACKGROUND" -eq 0 ]; then
        print_info_box "$SABLE_URL" "$SABLE_PORT" "(direct)"
        open_browser &
    fi
    _log "↳ exec uv run python server.py"
    exec uv run python server.py
fi
