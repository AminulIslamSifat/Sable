
# Sable environment configuration
# Copy to .env and adjust as needed. All are optional.

# Server port (default: 61770)
# Change if you run multiple instances or the port is taken.
# SABLE_PORT=61770

# Server bind address (default: 0.0.0.0)
# SABLE_HOST=0.0.0.0

# Persistent storage root — where sessions/tokens live.
# Useful if your project dir gets wiped/rebuilt frequently.
# Defaults to the project root itself.
# SABLE_PERSISTENT_ROOT=/path/to/persistent/storage

# Protected tree — comma-separated paths the agent cannot write to.
# Reads are always allowed; writes (rm, mv, cp, git add, echo >, etc.) are blocked.
# Leave unset to disable the write guard entirely.
# SABLE_PROTECTED_TREE=/path/to/protected/tree

# User display name injected into the system prompt.
# SABLE_USER_NAME=YourName
