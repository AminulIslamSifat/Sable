#!/usr/bin/env bash
# sable-boot — one-word boot. Unpacks a vault into tmpfs and optionally runs it.
#
#   sable-boot vault.sable [--run] [--venv .venv]
#
# Env: SABLE_BRIDGE, SABLE_BRIDGE_TOKEN
set -euo pipefail

if [ $# -lt 1 ]; then
  echo "usage: sable-boot <vault.sable> [--run] [--venv <path>]" >&2
  exit 2
fi

HERE="$(cd "$(dirname "$0")" && pwd)"
exec uv run --quiet \
  --with httpx --with cryptography --with pynacl \
  python "$HERE/boot.py" "$@"
