
[Unit]
Description=Sable TEST instance (port 61771)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/sifat/hdd/projects/test/Sable
ExecStartPre=/bin/bash -c 'command -v esbuild >/dev/null && [ -f web/src/app.js ] && esbuild web/src/app.js --bundle --outfile=web/dist/app.js --format=iife || true'
ExecStart=/usr/bin/uv run python server.py
Restart=on-failure
RestartSec=3
Environment=TERM=xterm-256color

[Install]
WantedBy=default.target
