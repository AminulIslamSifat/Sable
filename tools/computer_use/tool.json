[
  {
    "name": "computer_use",
    "description": "Control the computer: take screenshots, move/click mouse, type text, press keys, manage windows, read/write clipboard. Works on Windows and Linux (X11 + Wayland).",
    "parameters": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "screenshot",
            "mouse_click",
            "mouse_move",
            "mouse_drag",
            "mouse_scroll",
            "keyboard_type",
            "keyboard_key",
            "window_list",
            "window_focus",
            "window_resize",
            "window_close",
            "clipboard_get",
            "clipboard_set",
            "screen_info",
            "screen_parse"
          ],
          "description": "The action to perform."
        },
        "x": {
          "type": "integer",
          "description": "X coordinate (pixels from left). For screenshot region, mouse_move, mouse_click, mouse_drag start."
        },
        "y": {
          "type": "integer",
          "description": "Y coordinate (pixels from top). For screenshot region, mouse_move, mouse_click, mouse_drag start."
        },
        "x2": {
          "type": "integer",
          "description": "End X for mouse_drag or width for screenshot region / window_resize."
        },
        "y2": {
          "type": "integer",
          "description": "End Y for mouse_drag or height for screenshot region / window_resize."
        },
        "button": {
          "type": "string",
          "enum": ["left", "right", "middle"],
          "description": "Mouse button for click. Default: left."
        },
        "clicks": {
          "type": "integer",
          "description": "Number of clicks (2 = double-click). Default: 1.",
          "minimum": 1,
          "maximum": 10
        },
        "text": {
          "type": "string",
          "description": "Text to type (keyboard_type) or clipboard content (clipboard_set)."
        },
        "keys": {
          "type": "string",
          "description": "Key combo for keyboard_key, e.g. 'ctrl+c', 'alt+Tab', 'super+d', 'Return', 'F11'."
        },
        "direction": {
          "type": "string",
          "enum": ["up", "down", "left", "right"],
          "description": "Scroll direction. Default: down."
        },
        "amount": {
          "type": "integer",
          "description": "Scroll amount in clicks/steps. Default: 3.",
          "minimum": 1,
          "maximum": 100
        },
        "window_id": {
          "type": "string",
          "description": "Window ID or title for window_focus, window_resize, window_close."
        },
        "save_path": {
          "type": "string",
          "description": "File path to save screenshot. Default: auto-generated in output dir."
        },
        "fullscreen": {
          "type": "boolean",
          "description": "Screenshot entire screen (true) or use x/y/x2/y2 region. Default: true."
        },
        "filter_type": {
          "type": "string",
          "description": "For screen_parse: filter elements by control type (e.g. 'Button', 'Edit', 'Text'). Omit for all."
        },
        "max_elements": {
          "type": "integer",
          "description": "For screen_parse: max elements to return. Default: 50.",
          "minimum": 1,
          "maximum": 500
        }
      },
      "required": ["action"],
      "oneOf": [
        {
          "properties": {"action": {"const": "mouse_click"}},
          "required": ["action", "x", "y"]
        },
        {
          "properties": {"action": {"const": "mouse_move"}},
          "required": ["action", "x", "y"]
        },
        {
          "properties": {"action": {"const": "mouse_drag"}},
          "required": ["action", "x", "y", "x2", "y2"]
        },
        {
          "properties": {"action": {"const": "keyboard_type"}},
          "required": ["action", "text"]
        },
        {
          "properties": {"action": {"const": "keyboard_key"}},
          "required": ["action", "keys"]
        },
        {
          "properties": {"action": {"const": "window_focus"}},
          "required": ["action", "window_id"]
        },
        {
          "properties": {"action": {"const": "window_close"}},
          "required": ["action", "window_id"]
        },
        {
          "properties": {"action": {"const": "clipboard_set"}},
          "required": ["action", "text"]
        },
        {
          "properties": {"action": {"const": "mouse_scroll"}},
          "required": ["action"]
        },
        {
          "properties": {"action": {"const": "screenshot"}},
          "required": ["action"]
        },
        {
          "properties": {"action": {"const": "window_list"}},
          "required": ["action"]
        },
        {
          "properties": {"action": {"const": "clipboard_get"}},
          "required": ["action"]
        },
        {
          "properties": {"action": {"const": "screen_info"}},
          "required": ["action"]
        },
        {
          "properties": {"action": {"const": "screen_parse"}},
          "required": ["action"]
        }
      ]
    }
  }
]
